{
  "id": "/",
  "name": "Pullio — Media Downloader & Converter",
  "short_name": "Pullio",
  "description": "Download and convert video or audio from YouTube, TikTok, Douyin, Facebook, Bilibili, and more.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#030303",
  "theme_color": "#030303",
  "categories": ["utilities", "multimedia", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Downloader",
      "url": "/",
      "description": "Start a new media download"
    },
    {
      "name": "Transfers",
      "url": "/?tab=transfers",
      "description": "View active downloads"
    },
    {
      "name": "History",
      "url": "/?tab=history",
      "description": "View downloaded media history"
    },
    {
      "name": "Converter",
      "url": "/?tab=converter",
      "description": "Convert video & audio formats"
    }
  ]
}
