# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST defaults to 127.0.0.1 for local runs. Set 0.0.0.0 when hosting outside
# Cloud Run, and put authentication in front of the service before exposing it.
# HOST="0.0.0.0"

# PORT defaults to 3000; hosting platforms can provide their required port.

# Keep this directory on a persistent volume to recover downloads after restart.
# Defaults to the project directory; contains downloads/, uploads/, converted/,
# and pullio-data/download-queue.json. Do not expose this directory publicly.
# PULLIO_STORAGE_DIR="/path/to/persistent/pullio"

# Inactivity timeout for transfers (milliseconds). Default: 180000 (3 minutes).
# Merging/conversion allows at least 10 minutes without output changes.
# PULLIO_DOWNLOAD_STALL_MS="180000"

# Optional local development demos only. Disabled in production even when set.
# Recognized URLs: https://demo.pullio.invalid/video, /audio, or /playlist.
# PULLIO_ENABLE_DEMOS="1"
